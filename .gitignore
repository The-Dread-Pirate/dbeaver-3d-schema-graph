# --- Maven / Tycho build output ---
target/
*.jar
*.war
*.class

# --- Build logs (stray capture files) ---
build-*.log
*.log

# --- Eclipse / OSGi dev metadata ---
.metadata/
.settings/
.project
.classpath
bin/
.polyglot.*
.tycho-consumer-*

# --- IDE ---
.idea/
*.iml
.vscode/

# --- KiroCrew / local agent config (machine-specific) ---
.kiro/

# --- OS cruft ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Portable toolchain (lives outside the repo; never commit if copied in) ---
/toolchain/

# --- Node (renderer/ web build) ---
node_modules/

# NOTE: plugins/.../web/graph3d.bundle.js + index.html are generated by the
# renderer/ esbuild build but are intentionally COMMITTED, so `mvn verify`
# produces a working plugin without needing Node. Regenerate with
# `cd renderer && npm run build` and commit the result.
