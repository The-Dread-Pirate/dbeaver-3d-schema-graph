<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.views">
        <category
            id="org.jkiss.dbeaver.ext.graph3d.ui.category"
            name="DBeaver 3D Graph"/>
        <view
            id="org.jkiss.dbeaver.ext.graph3d.ui.Graph3DView"
            name="3D Schema Graph"
            category="org.jkiss.dbeaver.ext.graph3d.ui.category"
            class="org.jkiss.dbeaver.ext.graph3d.ui.Graph3DView"
            restorable="true">
        </view>
    </extension>

    <!-- Command that opens the selected schema/catalog in the 3D graph. -->
    <extension point="org.eclipse.ui.commands">
        <command
            id="org.jkiss.dbeaver.ext.graph3d.ui.openGraph"
            name="Open in 3D Schema Graph"
            categoryId="org.eclipse.ui.category.views"/>
    </extension>

    <!-- Command that opens the selected container as a schema overview. -->
    <extension point="org.eclipse.ui.commands">
        <command
            id="org.jkiss.dbeaver.ext.graph3d.ui.openOverview"
            name="Open in 3D Database Overview"
            categoryId="org.eclipse.ui.category.views"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler
            commandId="org.jkiss.dbeaver.ext.graph3d.ui.openGraph"
            class="org.jkiss.dbeaver.ext.graph3d.ui.OpenGraph3DHandler"/>
        <handler
            commandId="org.jkiss.dbeaver.ext.graph3d.ui.openOverview"
            class="org.jkiss.dbeaver.ext.graph3d.ui.OpenOverview3DHandler"/>
    </extension>

    <!-- Context-menu entry on Database Navigator nodes. The handler itself
         validates that the selection is a DBSObjectContainer, so the item is
         offered broadly and no-ops on non-container nodes. Same popup DBeaver's
         own navigator tools use (popup:org.eclipse.ui.popup.any?after=tools). -->
    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false"
            locationURI="popup:org.eclipse.ui.popup.any?after=tools">
            <!-- SCHEMA selected: the full table graph, labeled "3D Schema Graph". -->
            <command
                commandId="org.jkiss.dbeaver.ext.graph3d.ui.openGraph"
                label="Open in 3D Schema Graph"
                style="push">
                <visibleWhen checkEnabled="false">
                    <with variable="selection">
                        <count value="1"/>
                        <iterate>
                            <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSSchema"/>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
            <!-- DATABASE/CATALOG selected: the full (uncondensed) graph is the
                 "3D Database Neural View"; the condensed one is the overview. -->
            <command
                commandId="org.jkiss.dbeaver.ext.graph3d.ui.openGraph"
                label="Open in 3D Database Neural View"
                style="push">
                <visibleWhen checkEnabled="false">
                    <with variable="selection">
                        <count value="1"/>
                        <iterate>
                            <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSCatalog"/>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
            <command
                commandId="org.jkiss.dbeaver.ext.graph3d.ui.openOverview"
                label="Open in 3D Database Overview"
                style="push">
                <visibleWhen checkEnabled="false">
                    <with variable="selection">
                        <count value="1"/>
                        <iterate>
                            <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSCatalog"/>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
            <!-- Fallback: a container that is neither a DBSSchema nor DBSCatalog
                 (driver variation) still gets the full graph under the generic
                 "3D Schema Graph" label, so the command is never unreachable. -->
            <command
                commandId="org.jkiss.dbeaver.ext.graph3d.ui.openGraph"
                label="Open in 3D Schema Graph"
                style="push">
                <visibleWhen checkEnabled="false">
                    <with variable="selection">
                        <count value="1"/>
                        <iterate>
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject"/>
                            <not>
                                <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSSchema"/>
                            </not>
                            <not>
                                <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSCatalog"/>
                            </not>
                        </iterate>
                    </with>
                </visibleWhen>
            </command>
        </menuContribution>
    </extension>
</plugin>
